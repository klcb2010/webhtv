<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/shape_child_lock_dialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/child_lock_title"
        android:textColor="#FF1565C0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <!-- 整行与开关均可焦点；任一获焦时行保持深蓝高亮 -->
    <LinearLayout
        android:id="@+id/childLockSwitchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/selector_child_lock_row_focus"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusDown="@+id/childLockPassword">

        <TextView
            android:id="@+id/childLockEnableLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/child_lock_enable"
            android:textColor="#FF212121"
            android:textSize="16sp"
            android:duplicateParentState="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/childLockSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusDown="@+id/childLockPassword" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/childLockPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/child_lock_password_hint"
            android:textColor="#FF212121"
            android:textColorHint="#99212121"
            android:background="@drawable/selector_child_lock_edit"
            android:nextFocusUp="@+id/childLockSwitchRow"
            android:nextFocusDown="@+id/childLockPasswordConfirm" />

        <ImageButton
            android:id="@+id/childLockPasswordToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/selector_child_lock_focus"
            android:contentDescription="@string/child_lock_toggle_password"
            android:src="@drawable/ic_child_lock_eye_closed"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/childLockConfirmRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/childLockPasswordConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/child_lock_password_confirm_hint"
            android:textColor="#FF212121"
            android:textColorHint="#99212121"
            android:background="@drawable/selector_child_lock_edit"
            android:nextFocusUp="@+id/childLockPassword"
            android:nextFocusDown="@+id/childLockSave" />

        <ImageButton
            android:id="@+id/childLockPasswordConfirmToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/selector_child_lock_focus"
            android:contentDescription="@string/child_lock_toggle_password"
            android:src="@drawable/ic_child_lock_eye_closed"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/childLockHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/child_lock_setup_hint"
        android:textColor="#FF546E7A"
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/childLockCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="8dp"
            android:text="@string/child_lock_cancel"
            android:textColor="#FF1565C0"
            android:textSize="16sp"
            android:background="@drawable/selector_child_lock_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusUp="@+id/childLockPasswordConfirm" />

        <TextView
            android:id="@+id/childLockSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/child_lock_save"
            android:textColor="#FF1565C0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/selector_child_lock_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusUp="@+id/childLockPasswordConfirm" />
    </LinearLayout>
</LinearLayout>
