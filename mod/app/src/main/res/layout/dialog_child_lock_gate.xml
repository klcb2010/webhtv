<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/shape_child_lock_dialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/child_lock_gate_title"
        android:textColor="#FF1565C0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/child_lock_gate_message"
        android:textColor="#FF424242"
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/childLockGatePassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/child_lock_password_hint"
            android:textColor="#FF212121"
            android:textColorHint="#99212121"
            android:backgroundTint="#FF90CAF9" />

        <ImageButton
            android:id="@+id/childLockGatePasswordToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/selector_child_lock_focus"
            android:contentDescription="@string/child_lock_toggle_password"
            android:src="@drawable/ic_child_lock_eye_closed"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/childLockGateUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/child_lock_unlock"
        android:textColor="#FF1565C0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/selector_child_lock_focus"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />
</LinearLayout>
